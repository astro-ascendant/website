# Copy to .env.local and fill in. Never commit the real file.

# Neon Postgres connection string for stored birth details (server only).
# On Vercel, the Neon integration sets this for you. Without it the site
# still casts charts and keeps profiles in the browser only.
# Create the table once with: bun run db:migrate
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
